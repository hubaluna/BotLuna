{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formulove-bot",
  "main": "src/entry.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formulove-db"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": "./public/"
  }
}
